rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDosen() {
      return signedIn() && profile().role == 'dosen';
    }

    function isAdmin() {
      return signedIn() && profile().role == 'admin';
    }

    function isStudentInGroup(groupId) {
      return signedIn()
        && profile().role == 'mahasiswa'
        && profile().groupId == groupId;
    }

    function isProjectManager(groupId) {
      return isStudentInGroup(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)).data.leaderNim == profile().nim;
    }

    function isGroupLeader(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.leaderNim == profile().nim;
    }

    function canReviewMembers(groupId) {
      return isDosen() || isProjectManager(groupId);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'mahasiswa'
        && request.resource.data.nim is string
        && request.resource.data.name is string
        && !('groupId' in request.resource.data)
        && !('password' in request.resource.data);
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if isAdmin()
        || (signedIn()
          && (request.auth.uid == userId
            || isDosen()
            || (('groupId' in request.resource.data) && isGroupLeader(request.resource.data.groupId))
            || (('pendingGroupId' in resource.data) && isGroupLeader(resource.data.pendingGroupId)))
          && request.resource.data.role == resource.data.role
          && request.resource.data.nim == resource.data.nim
          && !('password' in request.resource.data)
          && ((!('groupId' in resource.data) && !('groupId' in request.resource.data))
            || (('groupId' in resource.data) && ('groupId' in request.resource.data)
              && resource.data.groupId == request.resource.data.groupId)
            || (request.resource.data.groupId is string
              && (isDosen() || isGroupLeader(request.resource.data.groupId)))));
      allow delete: if isAdmin();
    }

    // Group names and project titles are needed on the registration screen.
    // Mutations still require an authenticated owner or lecturer.
    match /groups/{groupId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin() || isDosen() || isStudentInGroup(groupId);

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if isAdmin() || isGroupLeader(groupId)
          || (isDosen()
            && request.resource.data.approvalRequestId is string
            && exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(request.resource.data.approvalRequestId))
            && get(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(request.resource.data.approvalRequestId)).data.status == 'pending');
        allow update, delete: if isAdmin() || isGroupLeader(groupId);
      }

      match /joinRequests/{requestId} {
        allow read: if isAdmin() || canReviewMembers(groupId)
          || (signedIn() && request.auth.uid == requestId);
        allow create: if signedIn()
          && request.auth.uid == requestId
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'pending'
          && request.resource.data.nim == profile().nim;
        allow update: if isAdmin() || canReviewMembers(groupId);
        allow delete: if isAdmin() || canReviewMembers(groupId)
          || (signedIn() && request.auth.uid == requestId);
      }

      match /tasks/{taskId} {
        allow read: if signedIn();
        allow create: if isAdmin() || isProjectManager(groupId)
          || (isStudentInGroup(groupId) && request.resource.data.status == 'todo');
        allow update: if isAdmin() || isProjectManager(groupId)
          || (isStudentInGroup(groupId)
            && resource.data.status == 'todo'
            && request.resource.data.status == 'todo');
        allow delete: if isAdmin() || isProjectManager(groupId)
          || (isStudentInGroup(groupId) && resource.data.status == 'todo');

        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if isAdmin() || isDosen() || isStudentInGroup(groupId);
          allow update, delete: if isAdmin();
        }
      }

      match /activities/{activityId} {
        allow read: if signedIn();
        allow create: if isAdmin() || isDosen() || isProjectManager(groupId) || isStudentInGroup(groupId);
        allow update, delete: if isAdmin();
      }
    }

    match /test/connection {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
